+        size_t bytes = pendingBulkList(&peer->sentReliableCommands)
+                     + pendingBulkList(&peer->outgoingSendReliableCommands)
+                     + pendingBulkList(&peer->outgoingCommands);
+        if (bytes > largest) largest = bytes;
+    }
+    return largest;
+}
