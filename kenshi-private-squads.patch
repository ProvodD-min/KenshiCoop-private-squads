+}
+static void file(unsigned id,unsigned offset,unsigned char byte){
+    coop::SaveFileHeader h={};h.type=coop::PKT_SAVE_FILE;h.xferId=id;h.fileIdx=0;h.pathLen=1;h.dataLen=1;h.offset=offset;
