+// Peer runtime platoon IDs are not native IDs in this process. Preserve each
+// remote group as one real local platoon rather than merging unknown groups
+// into the first player squad. Handles survive transport reconnects; world
+// reload explicitly clears the cache before any old handle can be reused.
+static GameWorld* peerSquadWorld=0;
+static std::map<std::pair<unsigned int,unsigned int>,hand> peerSquadAliases;
+void clearPeerSquadAliases(){peerSquadAliases.clear();peerSquadWorld=0;}
+
+// No SEH here: map/hand objects require ordinary C++ unwinding. The public
+// native entry below supplies the SEH boundary around pointer/native access.
+static ActivePlatoon* resolvePeerSquad(GameWorld* gw,Faction* faction,const unsigned int h[5]) {
+    if(peerSquadWorld!=gw){peerSquadAliases.clear();peerSquadWorld=gw;}
+    std::pair<unsigned int,unsigned int> key(h[1],h[2]);
+    std::map<std::pair<unsigned int,unsigned int>,hand>::iterator it=peerSquadAliases.find(key);
+    if(it!=peerSquadAliases.end()){
+        ActivePlatoon* cached=it->second.getActivePlatoon();
+        if(cached&&cached->me&&cached->me->getFaction()==faction)return cached;
+        peerSquadAliases.erase(it);
+    }
+    ActivePlatoon* target=0;
+    // Include populated AND empty common-save groups. A matching native
+    // platoon is safe only when both its index and serial match the wire key.
+    for(unsigned int i=0;i<faction->activePlatoons.size();++i){
+        Platoon* p=faction->activePlatoons[i];if(!p||!p->activePlatoon||p->getFaction()!=faction)continue;
+        const hand& ph=p->getHandle();
+        if(ph.container==h[1]&&ph.containerSerial==h[2]){target=p->activePlatoon;break;}
+    }
+    if(!target)target=gw->player->createSquad();
+    if(!target||!target->me||target->me->getFaction()!=faction)return 0;
+    peerSquadAliases[key]=target->me->getHandle();
+    return target;
+}
+
+bool joinPeerSquadAt(GameWorld* gw,Character* c,const unsigned int newHand[5]) {
+    if(!gw||!gw->player||!c||!newHand||!g_playerFactionFn||!g_getPlatoonFn)return false;
+    __try {
+        Faction* faction=g_playerFactionFn(gw->player);if(!faction)return false;
+        ActivePlatoon* target=resolvePeerSquad(gw,faction,newHand);if(!target)return false;
+        if(g_getPlatoonFn(c)==target&&isPlayerSquad(gw,static_cast<RootObject*>(c)))return true;
+        c->setFaction(faction,target);return true;
+    }__except(EXCEPTION_EXECUTE_HANDLER){return false;}
