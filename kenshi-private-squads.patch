+ args.output.mkdir(parents=True,exist_ok=True)
+ stem='peer-squad-alias-wrong-fields' if args.wrong_fields else ('peer-squad-alias-mutant' if args.mutation else 'peer-squad-alias')
+ cpp=args.output/(stem+'.cpp');exe=args.output/(stem+'.exe');obj=args.output/(stem+'.obj')
