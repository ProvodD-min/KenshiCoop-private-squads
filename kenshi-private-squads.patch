index 0000000..25efcb7
--- /dev/null
+++ b/scripts/test_empty_container.py
@@ -0,0 +1,164 @@
+"""Exercise the real applyContainerContents function with a fake engine.
+
+No Kenshi files, headers, or ABI are used. This is a control-flow regression,
+not a plugin build or an in-game test. A C++ compiler is required; exit 77 means
+unavailable. The old empty-container guards are restored in a mutation run,
+which MUST fail. Both runs compile the function extracted from EngineInventory.cpp.
+"""
+import argparse
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[1]
+SOURCE = ROOT / "src/plugin/game/EngineInventory.cpp"
+
+PREFIX = r'''
+#include <cstdio>
+#include <cstring>
+#include <cstdlib>
+#include <vector>
+#define __try try
+#define __except(x) catch (...)
+#define EXCEPTION_EXECUTE_HANDLER 1
+#ifndef _MSC_VER
+#define _snprintf snprintf
+#endif
+enum { INV_ITEMS_MAX = 64 };
+struct InvItemEntry {
+    unsigned char parentIdx; unsigned int itemType; char stringID[48];
+};
+struct Inventory { std::vector<InvItemEntry> rows; int calls; Inventory():calls(0){} };
+struct Item { Inventory* sub; Inventory* getInventory(){return sub;} };
+struct RootObject {};
+struct GameWorld {};
+static Inventory owner, bagA, bagB;
+static Item itemA, itemB;
+static RootObject object;
+static bool resolveOwner = true;
+static std::vector<Item*> localItems;
+static std::vector<InvItemEntry> localMeta;
+namespace coop { void logLine(const char*){} }
+bool isContainerItemType(unsigned int type){return type == 46;}
+RootObject* resolveObjectByHand(const unsigned int*) {return resolveOwner?&object:0;}
+Inventory* invOf(RootObject*) {return &owner;}
+unsigned int readInvItems(Inventory*, InvItemEntry* out, Item** objs,
+                         unsigned int maxOut, bool*) {
+    unsigned n = (unsigned)localMeta.size(); if(n>maxOut)n=maxOut;
+    for(unsigned i=0;i<n;++i){out[i]=localMeta[i];objs[i]=localItems[i];} return n;
+}
+// Fake only the low-level mutation. The production function under test must
+// choose the correct nested inventory, list, completeness flag, and call order.
+static bool applyToInventory(GameWorld*,Inventory* inv,const InvItemEntry* rows,
+                             unsigned int n,bool truncated){
+    ++inv->calls;
+    if(inv==&owner)return false;
+    if(!truncated)inv->rows.clear();
+    for(unsigned i=0;i<n;++i)inv->rows.push_back(rows[i]);
+    return true;
+}
+'''
+
+SUFFIX = r'''
+static InvItemEntry row(const char* sid,unsigned type,unsigned parent=0){
+    InvItemEntry e={}; e.itemType=type;e.parentIdx=(unsigned char)parent;
+    std::strncpy(e.stringID,sid,sizeof(e.stringID)-1);return e;
+}
+static void reset(){
+    owner=Inventory();bagA=Inventory();bagB=Inventory();resolveOwner=true;
+    itemA.sub=&bagA;itemB.sub=&bagB;localMeta.clear();localItems.clear();
+    bagA.rows.push_back(row("old_a",4));bagB.rows.push_back(row("old_b",4));
+}
+static void local(const char* sid,Item* it){localMeta.push_back(row(sid,46));localItems.push_back(it);}
+static int failures=0;
+static void check(bool ok,const char* label){std::printf("%s %s\n",ok?"PASS":"FAIL",label);if(!ok)++failures;}
+int main(){
+    GameWorld gw;unsigned h[5]={};
+    reset();local("bag_a",&itemA);
+    InvItemEntry empty[]={row("bag_a",46)};
+    bool changed=applyContainerContents(&gw,h,empty,1,false);
+    check(changed && bagA.rows.empty() && bagA.calls==1,"complete empty bag removes stale child");
+
+    reset();local("bag_a",&itemA);
+    applyContainerContents(&gw,h,empty,1,true);
+    check(bagA.rows.size()==1 && bagA.calls==0,"truncated absent children preserve contents");
+
+    reset();local("bag_a",&itemA);local("bag_b",&itemB);
+    InvItemEntry mixed[]={row("bag_a",46),row("bag_b",46),row("new_b",4,2)};
+    applyContainerContents(&gw,h,mixed,3,false);
+    check(bagA.rows.empty() && bagA.calls==1,"empty bag clears when another bag has children");
+    check(bagB.rows.size()==1 && !std::strcmp(bagB.rows[0].stringID,"new_b"),"nonempty sibling keeps its own children");
+
+    reset();local("bag_a",&itemA);local("bag_b",&itemB);
+    applyContainerContents(&gw,h,mixed,3,true);
+    check(bagA.rows.size()==1 && bagA.calls==0,"truncated mixed snapshot preserves omitted bag contents");
+    check(bagB.rows.size()==2 && bagB.calls==1,"truncated described children remain additive");
+
+    reset();local("bag_a",&itemA);
+    InvItemEntry noParent[]={row("ordinary",4)};
+    applyContainerContents(&gw,h,noParent,1,false);
+    check(bagA.rows.size()==1 && bagA.calls==0,"unmentioned parent does not authorize nested deletion");
+
+    reset();
+    applyContainerContents(&gw,h,empty,1,false);
+    check(bagA.calls==0 && bagB.calls==0,"missing local parent is never fabricated");
+
+    reset();local("same",&itemA);local("same",&itemB);
+    InvItemEntry twins[]={row("same",46),row("same",46),row("new_a",4,1)};
+    applyContainerContents(&gw,h,twins,3,false);
+    check(bagA.rows.size()==1 && !std::strcmp(bagA.rows[0].stringID,"new_a") && bagB.rows.empty(),"same-template empty sibling binds distinct inventory");
+
+    reset();local("bag_a",&itemA);resolveOwner=false;
+    applyContainerContents(&gw,h,empty,1,false);
+    check(bagA.calls==0 && owner.calls==0,"unresolved owner causes no mutation");
+    return failures?1:0;
+}
+'''
+
+def extract(source):
+    start = source.index("bool applyContainerContents(GameWorld*")
+    # The next namespace is the next top-level declaration in this translation unit.
+    end = source.index("\nnamespace {", start)
+    return source[start:end]
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--emit", type=Path, help="write standalone C++ for review without compiling")
+    args = parser.parse_args()
+    function = extract(SOURCE.read_text(encoding="utf-8"))
+    if args.emit:
+        args.emit.write_text(PREFIX + function + SUFFIX, encoding="utf-8")
+        print("EMITTED", args.emit)
+        return 0
+    compiler = next((shutil.which(x) for x in ("cl", "clang++", "g++") if shutil.which(x)), None)
+    if not compiler:
+        print("SKIP: C++ compiler unavailable; native regression and mutation control did not run")
+        return 77
+    mutant = function.replace("if (nTop == 0 || (nNested == 0 && truncated)) return changed;",
+                              "if (nNested == 0) return changed;")
+    mutant = mutant.replace("if (nk == 0 && (truncated || !isContainerItemType(top[t].itemType))) continue;",
+                            "if (nk == 0) continue;")
+    if mutant == function:
+        raise RuntimeError("Mutation could not restore old guards; review source and test")
+    build = ROOT / "build"
+    build.mkdir(exist_ok=True)
+    with tempfile.TemporaryDirectory(prefix="kenshi-empty-", dir=build) as temp:
+        for label, body, should_pass in (("fixed", function, True), ("old-guards", mutant, False)):
+            cpp = Path(temp) / (label + ".cpp")
+            exe = Path(temp) / (label + ".exe")
+            cpp.write_text(PREFIX + body + SUFFIX, encoding="utf-8")
+            if Path(compiler).stem.lower() == "cl":
+                command = [compiler, "/nologo", "/EHsc", str(cpp), "/Fe" + str(exe)]
+            else:
+                command = [compiler, "-std=c++11", str(cpp), "-o", str(exe)]
+            subprocess.run(command, cwd=temp, check=True)
+            result = subprocess.run([str(exe)], capture_output=True, text=True)
+            print(label + ":\n" + result.stdout)
+            if (result.returncode == 0) != should_pass:
+                raise RuntimeError(label + " produced an unexpected result")
+    print("PASS: fixed function passes and original guards fail")
+    return 0
+
+if __name__ == "__main__":
+    raise SystemExit(main())
