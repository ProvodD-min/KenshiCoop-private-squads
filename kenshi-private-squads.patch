+ build=subprocess.run(['cl','/nologo','/O2','/EHsc','/W3','/Fo'+str(obj.resolve()),'/Fe'+str(exe.resolve()),str(cpp.resolve())],capture_output=True,text=True)
+ (args.output/(stem+'-build.log')).write_text(build.stdout+build.stderr)
+ if build.returncode:raise SystemExit(build.stdout+build.stderr)
+ result=subprocess.run([str(exe.resolve())],capture_output=True,text=True)
+ (args.output/(stem+'.log')).write_text(result.stdout+result.stderr);print(result.stdout)
+ if args.mutation or args.wrong_fields:
