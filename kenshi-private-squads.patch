+PRE=r'''
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#include <cstdio>
+#include <map>
+#include <vector>
+#include <utility>
+struct ActivePlatoon;struct Faction;struct Platoon;
+struct hand { unsigned int index,serial,type,container,containerSerial; ActivePlatoon* getActivePlatoon()const; };
+static std::map<std::pair<unsigned int,unsigned int>,ActivePlatoon*> registry;
+ActivePlatoon* hand::getActivePlatoon()const {std::map<std::pair<unsigned int,unsigned int>,ActivePlatoon*>::iterator it=registry.find(std::make_pair(container,containerSerial));return it==registry.end()?0:it->second;}
+struct Platoon {Faction* faction;hand identity;ActivePlatoon* activePlatoon;Faction* getFaction(){return faction;}const hand& getHandle(){return identity;}};
+struct ActivePlatoon {Platoon* me;};
+struct RootObject {bool player;};
+static int moves=0,creates=0;static bool failCreate=false;
+struct Character:RootObject {ActivePlatoon* tab;Character(){tab=0;player=false;}void setFaction(Faction*,ActivePlatoon* p){tab=p;player=true;++moves;}};
+struct Faction {std::vector<Platoon*> activePlatoons;};
+static ActivePlatoon* make(Faction* f,unsigned int index,unsigned int serial){Platoon* p=new Platoon;ActivePlatoon* a=new ActivePlatoon;p->faction=f;p->identity.index=0;p->identity.serial=0;p->identity.type=34;p->identity.container=index;p->identity.containerSerial=serial;p->activePlatoon=a;a->me=p;f->activePlatoons.push_back(p);registry[std::make_pair(index,serial)]=a;return a;}
+struct PlayerInterface {Faction* faction;ActivePlatoon* createSquad(){if(failCreate)return 0;++creates;return make(faction,500+creates,9000+creates);}};
+struct GameWorld {PlayerInterface* player;};
+static Faction* factionOf(PlayerInterface* p){return p->faction;}
+static ActivePlatoon* platoonOf(Character* c){return c->tab;}
+static Faction* (*g_playerFactionFn)(PlayerInterface*)=&factionOf;
+static ActivePlatoon* (*g_getPlatoonFn)(Character*)=&platoonOf;
+static bool isPlayerSquad(GameWorld*,RootObject* c){return c->player;}
+'''
+POST=r'''
+static int checks=0,failed=0;
+static void check(const char* n,bool ok){++checks;if(!ok)++failed;printf("%s %s\n",ok?"PASS":"FAIL",n);}
+int main(){
+ Faction f,foreign;PlayerInterface p;p.faction=&f;GameWorld gw;gw.player=&p;
+ ActivePlatoon* leader=make(&f,1,111),*empty=make(&f,7,777);Character a,b,c;
+ unsigned int common[5]={1,7,777,9,99},remote[5]={1,65,6565,8,88},other[5]={1,66,6666,8,88};
+ check("empty common native squad resolves exact index and serial",joinPeerSquadAt(&gw,&a,common)&&a.tab==empty&&creates==0);
+ check("unknown remote group creates isolated native squad",joinPeerSquadAt(&gw,&b,remote)&&creates==1&&b.tab!=leader&&b.tab!=empty);
+ ActivePlatoon* alias=b.tab;int prior=moves;
+ check("same member target is idempotent",joinPeerSquadAt(&gw,&b,remote)&&creates==1&&moves==prior);
+ check("second remote member reuses group alias",joinPeerSquadAt(&gw,&c,remote)&&c.tab==alias&&creates==1);
+ check("transport reconnect retaining world cache reuses native group",joinPeerSquadAt(&gw,&c,remote)&&c.tab==alias&&creates==1);
+ check("different remote groups stay separate",joinPeerSquadAt(&gw,&c,other)&&c.tab!=alias&&creates==2);
+ ActivePlatoon* numericCollision=make(&f,65,6565);
+ check("cached alias wins over later native ID collision",joinPeerSquadAt(&gw,&c,remote)&&c.tab==alias&&c.tab!=numericCollision);
+ alias->me->faction=&foreign;
+ check("foreign faction stale alias is rejected",joinPeerSquadAt(&gw,&b,remote)&&b.tab==numericCollision&&b.tab!=alias);
+ unsigned int foreignKey[5]={1,77,7777,8,88};make(&foreign,77,7777);
+ check("foreign native platoon cannot be selected",joinPeerSquadAt(&gw,&b,foreignKey)&&b.tab->me->getFaction()==&f&&creates==3);
+ unsigned int missing[5]={1,99,9999,8,88};failCreate=true;
+ check("failed native group creation never falls back to leader",!joinPeerSquadAt(&gw,&b,missing)&&b.tab!=leader);
+ failCreate=false;clearPeerSquadAliases();int before=creates;
+ check("explicit world reset drops remote aliases",joinPeerSquadAt(&gw,&c,other)&&creates==before+1);
+ GameWorld next;next.player=&p;before=creates;
+ check("world pointer change drops old alias cache",joinPeerSquadAt(&next,&c,other)&&creates==before+1);
+ check("missing world fails closed",!joinPeerSquadAt(0,&c,other));
+ check("missing character fails closed",!joinPeerSquadAt(&gw,0,other));
+ check("missing hand fails closed",!joinPeerSquadAt(&gw,&c,0));
+ printf("peer-squad-alias: %d/%d checks passed\n",checks-failed,checks);return failed?1:0;
+}
+'''
+
+def main():
+ p=argparse.ArgumentParser();p.add_argument('output',type=Path);p.add_argument('--mutation',action='store_true');p.add_argument('--wrong-fields',action='store_true');args=p.parse_args()
+ source=(ROOT/'src/plugin/game/EngineWorld.cpp').read_text()
