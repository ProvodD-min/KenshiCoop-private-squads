+def components(header, source):
+    start = header.index("    struct OutSave")
+    fields = header[start:header.index("    // Reliable coordinated-load packets", start)]
+    start = source.index("void NetLink::queueSaveReq(")
+    methods = source[start:source.index("void NetLink::queueLoadGo(", start)]
+    start = source.index("template<class T>\nvoid pushLocked(")
+    helper = source[start:source.index("\n}", start)+2]
+    start = source.index("        std::vector<SaveReqPacket>")
+    drain = source[start:source.index("        // Drain + send queued coordinated-load packets", start)]
+    return PREFIX + fields + "};\n" + helper + "\n" + methods + "\nvoid NetLink::drainForTest(){\n" + drain + "}\n" + SUFFIX
+
+def old(path):
+    return subprocess.run(["git", "-C", str(ROOT), "show", BASE + ":" + path],capture_output=True,text=True,check=True).stdout
+
+def main():
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--emit",type=Path)
+    args=parser.parse_args()
+    header=(ROOT/"src/plugin/net/NetLink.h").read_text(encoding="utf-8")
+    source=(ROOT/"src/plugin/net/NetLink.cpp").read_text(encoding="utf-8")
+    program=components(header,source)
+    if args.emit:
