+"""Compile production save queue methods and net-thread drain against fake ENet.
+
+Checks wire bytes and transfer ordering, including producer enqueue during a
+drain. Original grouped queues form a mutation control. Exit77 means no compiler.
+This is not an ENet or game-ABI test.
+"""
+import argparse
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[1]
+BASE = "5a761e19a4184b42315e96ea7e92e3c1403d54db"
+
+PREFIX = r'''
+#include <cstdio>
+#include <cstring>
+#include <vector>
+#ifndef _MSC_VER
+#define __int64 long long
+#endif
+#include "Wire.h"
+typedef int CRITICAL_SECTION;
+static void EnterCriticalSection(CRITICAL_SECTION*){}
+static void LeaveCriticalSection(CRITICAL_SECTION*){}
+enum {ENET_PACKET_FLAG_RELIABLE=1, ENET_PEER_STATE_CONNECTED=5, CH_BULK=2};
+struct ENetPeer {int state;};
+struct ENetPacket {unsigned char* data;size_t size;int flags;};
+struct Sent {std::vector<unsigned char> bytes;int channel,flags,route;};
+static std::vector<Sent> sent;
+static int destroyed=0;
+static bool inject=false;
+static void injectTransfer();
+static ENetPacket* enet_packet_create(const void* data,size_t n,int flags){
+    ENetPacket* p=new ENetPacket;p->data=new unsigned char[n];p->size=n;p->flags=flags;
+    if(data)std::memcpy(p->data,data,n);return p;
+}
+static void enet_packet_destroy(ENetPacket* p){++destroyed;delete[]p->data;delete p;}
+static void sendPacket(ENetPacket* p,int channel,int route){
+    Sent s;s.bytes.assign(p->data,p->data+p->size);s.channel=channel;s.flags=p->flags;s.route=route;sent.push_back(s);
+    enet_packet_destroy(p);
+    if(inject){inject=false;injectTransfer();}
+}
+static void enet_host_broadcast(void*,int channel,ENetPacket* p){sendPacket(p,channel,1);}
+static void enet_peer_send(ENetPeer*,int channel,ENetPacket* p){sendPacket(p,channel,2);}
+namespace coop {
+class NetLink {
+public:
+    bool isHost_;void* enetHost_;ENetPeer* serverPeer_;CRITICAL_SECTION outCs_;
+    NetLink():isHost_(true),enetHost_(0),serverPeer_(0),outCs_(0){}
+    void queueSaveReq(const SaveReqPacket&);
+    void queueSaveBegin(const SaveBeginPacket&);
+    void queueSaveFile(const SaveFileHeader&,const char*,const unsigned char*,unsigned int);
+    void queueSaveDone(const SaveDoneHeader&,const u32*,unsigned int);
+    void queueSaveAck(const SaveAckPacket&);
+    void drainForTest();
+'''
