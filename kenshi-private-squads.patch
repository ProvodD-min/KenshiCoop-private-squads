+// QA executable: actual NetLink, SteamP2P (inactive), CoopLog and SaveXfer.
+// The sole engine adapter supplies a caller-owned generated-save directory.
+#include "net/NetLink.h"
+#include "sync/SaveXfer.h"
+#include "CoopLog.h"
+#include <cstdio>
+#include <cstring>
+#include <fstream>
+#include <algorithm>
+static std::string saveRoot;
+namespace coop { namespace engine {
+bool saveInfo(char* game,unsigned gl,char* path,unsigned pl){
+ if(game&&gl)game[0]=0;if(path&&pl)_snprintf(path,pl,"%s",saveRoot.c_str());return true;
+}
+} }
+int main(int argc,char** argv){
+ if(argc!=6)return 2;bool host=strcmp(argv[1],"host")==0;int port=atoi(argv[2]);unsigned duration=atoi(argv[5]);
+ saveRoot=std::string(argv[3])+"\\save";CreateDirectoryA(saveRoot.c_str(),0);
+ coop::logInit((std::string(argv[3])+"\\net.log").c_str(),host?"HOST":"JOIN");
+ coop::Inbound inbound;coop::NetLink net;
+ if(!(host?net.startHost(port,&inbound):net.startClient("127.0.0.1",port,&inbound)))return 3;
+ DWORD start=GetTickCount(),connected=0,lastPublish=0,lastControl=0,ackAt=0;
+ unsigned motions=0,controls=0,maxMotionGap=0,lastMotion=0,maxControlLatency=0;
+ unsigned commit=0,ack=0,controlSeq=0,lastRemoteSeq=0;bool began=false;
+ while(GetTickCount()-start<duration){DWORD now=GetTickCount();
+  std::deque<coop::u32> peers;inbound.drainConnects(peers);if(!peers.empty()&&!connected)connected=now;
+  if(!host&&net.localId()&&!connected)connected=now;
+  if(connected&&now-lastPublish>=50){lastPublish=now;coop::EntityState rows[17];memset(rows,0,sizeof(rows));
+   for(unsigned i=0;i<17;++i){rows[i].hType=1;rows[i].hIndex=i+1;rows[i].hSerial=123+i;rows[i].x=float((now-start)/50);rows[i].cMoving=1;rows[i].cSpeed=4;}
+   net.setOwnedEntities(net.localId(),rows,17);
+  }
+  if(connected&&now-lastControl>=200){lastControl=now;coop::EventPacket e={0};e.type=coop::PKT_EVENT;e.ownerId=net.localId();e.eventId=++controlSeq;e.sSerial=now;net.queueEvent(e);}
+  if(host&&connected&&!began&&now-connected>=500){began=coop::savexfer::beginSend(net,0,"generated");}
+  if(host&&began)coop::savexfer::tickSend(net,0);
+  std::deque<coop::InboundEntity> entities;inbound.drainEntities(entities);
+  for(size_t i=0;i<entities.size();++i)if(entities[i].e.hIndex==1&&unsigned(entities[i].e.x)>lastRemoteSeq){
+   lastRemoteSeq=unsigned(entities[i].e.x);++motions;if(lastMotion)maxMotionGap=(std::max)(maxMotionGap,unsigned(now-lastMotion));lastMotion=now;
+  }
+  std::deque<coop::InboundEvent> events;inbound.drainEvents(events);
+  for(size_t i=0;i<events.size();++i){++controls;maxControlLatency=(std::max)(maxControlLatency,unsigned(now-events[i].ev.sSerial));}
+  std::deque<coop::InboundSaveEvent> saves;inbound.drainSaveBatch(saves);
+  for(size_t i=0;i<saves.size();++i){const coop::InboundSaveEvent& e=saves[i];
+   if(e.type==coop::PKT_SAVE_BEGIN)coop::savexfer::onSaveBegin(e.begin.pkt);
+   else if(e.type==coop::PKT_SAVE_FILE)coop::savexfer::onSaveFile(e.file.hdr,e.file.path.c_str(),e.file.data.empty()?0:&e.file.data[0]);
+   else if(e.type==coop::PKT_SAVE_DONE){coop::u16 files=0;unsigned __int64 bytes=0;int ok=coop::savexfer::onSaveDone(e.done.hdr,e.done.crcs.empty()?0:&e.done.crcs[0],&files,&bytes);
+    coop::SaveAckPacket a={0};a.type=coop::PKT_SAVE_ACK;a.ownerId=net.localId();a.xferId=e.done.hdr.xferId;a.ok=ok?1:0;a.files=files;a.bytes=bytes;net.queueSaveAck(a);commit=ok?1:2;ackAt=now;
+   }
+  }
+  std::deque<coop::InboundSaveAck> acks;inbound.drainSaveAcks(acks);
+  for(size_t i=0;i<acks.size();++i){ack=acks[i].pkt.ok?1:2;ackAt=now;}
+  if(ackAt&&now-ackAt>2000)break;
+  Sleep(5);
+ }
+ net.stop();coop::logClose();
+ std::ofstream report(argv[4]);report<<"{\"side\":\""<<(host?"host":"join")<<"\",\"connected\":"<<(connected?1:0)<<",\"motions\":"<<motions<<",\"controls\":"<<controls<<",\"max_motion_gap_ms\":"<<maxMotionGap<<",\"max_control_latency_ms\":"<<maxControlLatency<<",\"commit\":"<<commit<<",\"ack\":"<<ack<<",\"fingerprint\":"<<coop::savexfer::folderFingerprint("generated")<<",\"elapsed_ms\":"<<GetTickCount()-start<<"}";
+ return 0;
+}
