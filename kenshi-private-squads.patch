+"""Build the real Windows transport test in an x64 VC/SDK command prompt.
+
+Requires Python 3.9+, cl/link on PATH, standard INCLUDE/LIB configured.
+No Kenshi install, SDK, import library or game assets are required.
+"""
+from pathlib import Path
+import argparse, os, subprocess
+HERE=Path(__file__).resolve().parent
+REPO=HERE.parents[1]
+
+def main():
+ p=argparse.ArgumentParser();p.add_argument('--output',type=Path,required=True);args=p.parse_args()
+ directory=args.output.resolve();directory.mkdir(parents=True,exist_ok=True)
+ sources=[HERE/'netlink_node.cpp',REPO/'src/plugin/net/NetLink.cpp',REPO/'src/plugin/net/SteamP2P.cpp',REPO/'src/plugin/CoopLog.cpp',REPO/'src/plugin/sync/SaveXfer.cpp']
+ sources += sorted(p for p in (REPO/'third_party/enet/enet').glob('*.c') if p.name!='unix.c')
+ objects=[]
+ with (directory/'build.log').open('w',encoding='utf-8') as log:
+  def run(cmd):
+   result=subprocess.run([str(x) for x in cmd],cwd=directory,capture_output=True,text=True,errors='replace')
+   log.write(subprocess.list2cmdline([str(x) for x in cmd])+'\n'+result.stdout+result.stderr+'\n');log.flush()
+   if result.returncode:raise RuntimeError(result.stdout+result.stderr)
+  for i,source in enumerate(sources):
+   obj=directory/(str(i)+'.obj');objects.append(obj)
+   run(['cl.exe','/nologo','/c','/O2','/MD','/DENET_STATIC','/DWIN32_LEAN_AND_MEAN','/D_CRT_SECURE_NO_WARNINGS','/I'+str(REPO/'src/plugin'),'/I'+str(REPO/'third_party/enet/enet/include'),'/I'+str(REPO/'third_party/vc10_compat'),'/Fo'+str(obj),'/TC' if source.suffix=='.c' else '/EHsc',source])
+  exe=directory/'NetLinkQA.exe'
+  run(['link.exe','/nologo','/MACHINE:X64','/SUBSYSTEM:CONSOLE','/OUT:'+str(exe),*objects,'ws2_32.lib','winmm.lib','user32.lib'])
+ print(exe)
+if __name__=='__main__':main()
