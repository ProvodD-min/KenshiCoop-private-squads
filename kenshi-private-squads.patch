+} // namespace coop
+static coop::NetLink net;
+static int failures=0;
+static void check(bool ok,const char* label){std::printf("%s %s\n",ok?"PASS":"FAIL",label);if(!ok)++failures;}
+static unsigned idAt(size_t i){
+    if(i>=sent.size())return 0;
+    const unsigned char* p=&sent[i].bytes[0];
+    if(p[0]==coop::PKT_SAVE_BEGIN){coop::SaveBeginPacket h;std::memcpy(&h,p,sizeof(h));return h.xferId;}
