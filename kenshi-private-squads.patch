+// Tests the actual recruit routing helper with a deterministic native adapter.
+// It does not call the game or model the whole replication system.
+#include "../src/plugin/game/PrivateRecruit.h"
+#include <cstdio>
+#include <vector>
+#include <cstring>
+class RootObject { public: unsigned int hand[5]; };
+class Character:public RootObject {};
+class GameWorld {};
+static std::vector<coop::EntityState> roster;
+static std::vector<coop::EntityState> owned;
+static unsigned int movedTo[5];
+static int moves=0;static bool moveOk=true,staleMove=false,handOk=true;
+namespace coop { namespace engine {
+bool readObjectHand(RootObject* obj,unsigned int out[5]) { if(!obj||!handOk)return false;memcpy(out,obj->hand,sizeof(obj->hand));return true; }
+unsigned int captureSquad(GameWorld*,bool,EntityState* out,unsigned int cap) {unsigned int n=(unsigned int)roster.size();if(n>cap)n=cap;for(unsigned int i=0;i<n;++i)out[i]=roster[i];return n;}
+bool joinPlayerSquadAt(GameWorld*,Character* c,const unsigned int h[5]) {++moves;memcpy(movedTo,h,sizeof(movedTo));if(!moveOk)return false;if(!staleMove){c->hand[1]=h[1];c->hand[2]=h[2];++c->hand[3];}return true;}
+}}
+static int classifier(const unsigned int h[5]) {
+    for(unsigned int i=0;i<owned.size();++i){unsigned int x[5];coop::privateRecruit::handOf(owned[i],x);if(!memcmp(h,x,sizeof(x)))return 1;}
+    return 2;
+}
+static coop::EntityState member(unsigned int container,unsigned int serial,unsigned int index) {
+    coop::EntityState e;memset(&e,0,sizeof(e));e.hType=1;e.hContainer=container;e.hContainerSerial=serial;e.hIndex=index;e.hSerial=999+index;return e;
+}
+static void reset(Character& c) {roster.clear();owned.clear();moves=0;moveOk=handOk=true;staleMove=false;coop::privateRecruit::handOf(member(10,100,99),c.hand);}
+static int checks=0,failures=0;
+static void check(const char* n,bool ok){++checks;if(!ok)++failures;std::printf("%s %s\n",ok?"PASS":"FAIL",n);}
+int main(){
+    GameWorld gw;Character c;reset(c);
+    roster.push_back(member(10,100,1));roster.push_back(member(20,200,2));owned.push_back(roster[1]);
+    check("guest recruit leaves host default platoon",coop::privateRecruit::route(&gw,&c,&classifier)==2&&c.hand[1]==20&&c.hand[2]==200&&moves==1);
+    check("verified routed hand preserves body serial",c.hand[4]==1098);
+    check("routing is idempotent once in owned platoon",coop::privateRecruit::route(&gw,&c,&classifier)==1&&moves==1);
+    reset(c);roster.push_back(member(10,100,1));owned.push_back(roster[0]);
+    check("host recruit already in its own tab stays there",coop::privateRecruit::route(&gw,&c,&classifier)==1&&moves==0);
+    reset(c);roster.push_back(member(30,300,3));roster.push_back(member(20,200,2));owned=roster;
+    check("fallback owned anchor is deterministic across roster order",coop::privateRecruit::route(&gw,&c,&classifier)==2&&c.hand[1]==20);
+    reset(c);roster.push_back(member(30,300,3));roster.push_back(member(10,100,1));owned=roster;
+    check("existing owned destination preserved before fallback",coop::privateRecruit::route(&gw,&c,&classifier)==1&&moves==0);
+    reset(c);roster.push_back(member(10,100,99));owned=roster;
+    check("new recruit cannot authorize its own default tab",coop::privateRecruit::route(&gw,&c,&classifier)==0&&moves==0);
+    reset(c);roster.push_back(member(10,100,1));
+    check("missing owned anchor never falls back to peer",coop::privateRecruit::route(&gw,&c,&classifier)==0&&moves==0);
+    reset(c);roster.push_back(member(20,200,2));owned=roster;moveOk=false;
+    check("native move failure is reported",coop::privateRecruit::route(&gw,&c,&classifier)==-1&&c.hand[1]==10);
+    reset(c);roster.push_back(member(20,200,2));owned=roster;staleMove=true;
+    check("success return without actual recontainer is rejected",coop::privateRecruit::route(&gw,&c,&classifier)==-1&&c.hand[1]==10);
+    reset(c);handOk=false;
+    check("unreadable recruit hand fails closed",coop::privateRecruit::route(&gw,&c,&classifier)==-1&&moves==0);
+    check("absent ownership classifier fails closed",coop::privateRecruit::route(&gw,&c,0)==-1);
+    check("absent world fails closed",coop::privateRecruit::route(0,&c,&classifier)==-1);
+    check("absent recruit fails closed",coop::privateRecruit::route(&gw,0,&classifier)==-1);
+    std::printf("private-recruit: %d/%d checks passed\n",checks-failures,checks);return failures?1:0;
+}
