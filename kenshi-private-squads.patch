+++ b/src/plugin/game/PrivateRecruit.h
@@ -0,0 +1,46 @@
+#pragma once
+#include "Engine.h"
+
+// Route a successful LOCAL recruit before its final hand is captured by the
+// recruit detour. Native platoon membership, unlike temporary ownership pins,
+// survives the shared save and restores the correct owner after a reload.
+namespace coop {
+namespace privateRecruit {
+inline void handOf(const EntityState& e, unsigned int h[5]) {
+    h[0]=e.hType;h[1]=e.hContainer;h[2]=e.hContainerSerial;
+    h[3]=e.hIndex;h[4]=e.hSerial;
+}
+inline bool lessHand(const unsigned int a[5],const unsigned int b[5]) {
+    for(unsigned int i=0;i<5;++i){if(a[i]!=b[i])return a[i]<b[i];}
+    return false;
+}
+// 1 = already in an owned tab, 2 = moved and verified, 0 = no owned anchor,
+// -1 = native hand/move unavailable. Never fall back to the peer's first tab.
+inline int route(GameWorld* gw,Character* recruit,engine::InvOwnerClassFn owner) {
+    if(!gw||!recruit||!owner)return -1;
+    unsigned int current[5]={0,0,0,0,0};
+    if(!engine::readObjectHand(reinterpret_cast<RootObject*>(recruit),current))return -1;
+    const unsigned int CAP=160;
+    EntityState rows[CAP];
+    unsigned int count=engine::captureSquad(gw,false,rows,CAP);
+    bool found=false;unsigned int target[5]={0,0,0,0,0};
+    for(unsigned int i=0;i<count&&i<CAP;++i){
+        unsigned int h[5];handOf(rows[i],h);
+        // Ownership is sampled before this engine tick. A native recruit may
+        // already appear in the new roster, but cannot be its own owner anchor.
+        bool same=true;for(unsigned int k=0;k<5;++k)if(h[k]!=current[k])same=false;
+        if(same||owner(h)!=1)continue;
+        if(h[1]==current[1]&&h[2]==current[2])return 1;
+        if(!found||lessHand(h,target)){
+            for(unsigned int k=0;k<5;++k)target[k]=h[k];
+            found=true;
+        }
+    }
+    if(!found)return 0;
+    if(!engine::joinPlayerSquadAt(gw,recruit,target))return -1;
+    unsigned int after[5]={0,0,0,0,0};
+    if(!engine::readObjectHand(reinterpret_cast<RootObject*>(recruit),after))return -1;
+    return after[1]==target[1]&&after[2]==target[2]?2:-1;
+}
+}
+}
diff --git a/src/plugin/game/PrivateSquadUi.h b/src/plugin/game/PrivateSquadUi.h
new file mode 100644
index 0000000..a162a86
--- /dev/null
+++ b/src/plugin/game/PrivateSquadUi.h
@@ -0,0 +1,231 @@
+#pragma once
+#include <kenshi/gui/MainBarGUI.h>
+#include <kenshi/gui/PortraitManager.h>
+#include <kenshi/gui/SquadManagementScreen.h>
+#include <kenshi/Globals.h>
+#include <kenshi/GlobalConstants.h>
+#include <mygui/MyGUI_TabControl.h>
+
+// Presentation-only filters. Never remove platoons from the faction, the
+// player roster, or a save. Keep native portrait/index maps intact.
+namespace coop { namespace engine { namespace privateSquads {
+static InvOwnerClassFn classify=0;
+static GameWorld* world=0;
+static bool enabled=false, ready=false;
+static DWORD mainThread=0;
+static std::set<ActivePlatoon*> localTabs;
+// Session-only identities for empty squads explicitly created in our UI.
+// Native world/network squad creation never enters the onAddSquad scope.
+static std::set<hand> createdTabs;
+static unsigned int addSquadDepth=0,localCharacterCount=0;
+static Character* firstLocalCharacter=0;
+static bool active(){return enabled&&ready&&GetCurrentThreadId()==mainThread;}
+static int characterClass(RootObject* c) {
+    unsigned int h[5]={0,0,0,0,0};
+    return c&&classify&&readObjectHand(c,h)?classify(h):0;
+}
+static bool owns(ActivePlatoon* p){return localTabs.find(p)!=localTabs.end();}
+typedef void (__fastcall* BarFn)(MainBarGUI*);
+typedef void (__fastcall* ManageFn)(SquadManagementScreen*);
+typedef void (__fastcall* CellFn)(PortraitMainCellView*,const MyGUI::IBDrawItemInfo&,PortraitData*);
+typedef void (__fastcall* SquadCellFn)(SquadManagementScreen::PortraitSquadCellView*,const MyGUI::IBDrawItemInfo&,PortraitData*);
+typedef void (__fastcall* SelectFn)(PlayerInterface*,RootObject*,bool);
+typedef void (__fastcall* AddSquadFn)(SquadManagementScreen*,MyGUI::Widget*);
+typedef ActivePlatoon* (__fastcall* CreateSquadFn)(PlayerInterface*);
+// The bundled MyGUI has an extra update flag absent from the SDK header.
+// Resolve its real ABI instead of importing the nonexistent SDK overload.
+typedef void (__fastcall* RemoveUiItemFn)(MyGUI::ItemBox*,size_t,bool);
+static BarFn barOriginal=0,refreshBarOriginal=0;
+static ManageFn manageOriginal=0,refreshManageOriginal=0;
+static CellFn cellOriginal=0;
+static SquadCellFn squadCellOriginal=0;
+static SelectFn selectOriginal=0;
+static AddSquadFn addSquadOriginal=0;
+static CreateSquadFn createSquadOriginal=0;
+static RemoveUiItemFn removeUiItem=0;
+static bool refreshDeferred=false;
+static bool canRefreshPortraits() {
+    // Native refreshPortraitTabs unconditionally dereferences the selected
+    // Platoon's activePlatoon. During a shared-world load, that tab can be
+    // registered before its first character activates it. Defer the WHOLE
+    // native refresh, before any UI mutation, until its precondition holds.
+    __try {
+        if(!ou||!ou->player)return false;
+        Platoon* p=ou->player->getCurrentPlatoon();
+        return p&&p->activePlatoon;
+    }__except(EXCEPTION_EXECUTE_HANDLER){return false;}
+}
+
+// MyGUI's public setButtonWidth maps width <= 0 to the default width.
+// Steam 1.0.65's bundled MyGUI keeps TabItemInfo at +0x580 (stride 0x58)
+// and the sum of widths at +0x4b8. Validate every entry against the public
+// API before touching this presentation-only state. No TabItem is removed.
+class TabBarAccess : public MyGUI::TabControl {
+public:
+    void relayoutPrivateTabs(){updateBar();}
+};
+static bool collapseTab(MyGUI::TabControl* tabs,size_t index) {
+    size_t count=tabs->getItemCount();
+    if(index>=count||count>1024)return false;
+    char* raw=reinterpret_cast<char*>(tabs);
+    char* begin=*reinterpret_cast<char**>(raw+0x580);
+    char* end=*reinterpret_cast<char**>(raw+0x588);
+    if(!begin||end<begin||size_t(end-begin)!=count*0x58)return false;
+    int total=0;
+    for(size_t i=0;i<count;++i){
+        int width=*reinterpret_cast<int*>(begin+i*0x58);
+        if(width<0||width>100000||tabs->getButtonWidthAt(i)!=width)return false;
+        total+=width;
+    }
+    int& widthSum=*reinterpret_cast<int*>(raw+0x4b8);
+    if(total!=widthSum)return false;
+    int& width=*reinterpret_cast<int*>(begin+index*0x58);
+    if(width){
+        widthSum-=width; width=0;
+        reinterpret_cast<TabBarAccess*>(tabs)->relayoutPrivateTabs();
+    }
+    return true;
+}
+
+static void filterBar(MainBarGUI* bar) {
+    if(!active()||!bar)return;
+    __try {
+        // A loaded save can already focus the other player's character before
+        // the selection hook is enabled. Check the actual displayed object;
+        // selectedCharacter can retain an older PC while an NPC is inspected.
+        if(world&&world->player&&characterClass(bar->selectedObject.getRootObject())==2){
+            world->player->clearSelection();
+            if(firstLocalCharacter&&characterClass(static_cast<RootObject*>(firstLocalCharacter))==1)
+                world->player->_selectPlayerCharacter(static_cast<RootObject*>(firstLocalCharacter),false,false);
+        }
+        MyGUI::TabControl* tabs=bar->portraitsTabPanel;
+        if(!tabs)return;
+        MyGUI::TabItem* first=0;bool selectedOwn=false;
+        for(size_t i=0;i<bar->tabPortraits.size();++i){
+            MainTabPortraitPlatoon& t=bar->tabPortraits[i];if(!t.tab)continue;
+            bool mine=owns(t.platoon);
+            if(mine){
+                if(tabs->getButtonWidth(t.tab)==0)tabs->setButtonWidth(t.tab,MyGUI::DEFAULT);
+            }else if(!collapseTab(tabs,tabs->getItemIndex(t.tab))){
+                static bool reported=false;
+                if(!reported){reported=true;logLine("[private-squads] ERROR unsupported MyGUI tab layout");}
+            }
+            if(mine){if(!first)first=t.tab;if(tabs->getItemSelected()==t.tab)selectedOwn=true;}
+        }
+        if(first&&!selectedOwn)tabs->setItemSelected(first);
+    }__except(EXCEPTION_EXECUTE_HANDLER){logLine("[private-squads] ERROR mainbar filter unavailable");}
+}
+static void updateCountCaption(SquadManagementScreen* screen) {
+    if(!screen->txtFactionSize||!con)return;
+    char caption[64];
+    _snprintf_s(caption,sizeof(caption),_TRUNCATE,"%u/%d",localCharacterCount,con->MAX_FACTION_SIZE);
+    // Preserve native factionSize: it is the game's global change cache.
+    screen->txtFactionSize->setCaption(MyGUI::UString(caption));
+}
+static void filterManage(SquadManagementScreen* screen) {
+    if(!active()||!screen)return;
+    __try {
+        if(!screen->panelSquads)return;
+        MyGUI::ItemBox* box=screen->panelSquads->getItemBox();if(!box)return;
+        for(size_t i=box->getItemCount();i>0;--i){
+            SquadManagementScreen::SquadData** p=box->getItemDataAt<SquadManagementScreen::SquadData*>(i-1,false);
+            if(p&&*p&&!owns((*p)->platoon)&&removeUiItem)removeUiItem(box,i-1,true);
+        }
+        updateCountCaption(screen);
+    }__except(EXCEPTION_EXECUTE_HANDLER){logLine("[private-squads] ERROR management filter unavailable");}
+}
+static void __fastcall barHook(MainBarGUI* p){
+    if(refreshDeferred&&canRefreshPortraits()){
+        refreshDeferred=false;refreshBarOriginal(p);
+        logLine("[private-squads] deferred portrait refresh resumed");
+    }
+    barOriginal(p);filterBar(p);
+}
+static void __fastcall refreshBarHook(MainBarGUI* p){
+    if(!canRefreshPortraits()){
+        if(!refreshDeferred)logLine("[private-squads] portrait refresh deferred: selected platoon inactive");
+        refreshDeferred=true;return;
+    }
+    refreshDeferred=false;refreshBarOriginal(p);filterBar(p);
+}
+static void repairEmptyManagement(SquadManagementScreen* p) {
+    if(!active()||!p||!localCharacterCount||!world||!world->player)return;
+    __try {
+        // Loading a world clears the visible ItemBox but can retain the same
+        // native factionSize cache. Native update then sees no size change
+        // and never rebuilds it. Refresh only a visible, empty, current-world
+        // panel; keep the native factionSize cache and world roster intact.
+        if(p->faction!=world->player->participant||!p->getVisible()||!p->panelSquads)return;
+        MyGUI::ItemBox* box=p->panelSquads->getItemBox();
+        if(box&&box->getItemCount()==0)refreshManageOriginal(p);
+    }__except(EXCEPTION_EXECUTE_HANDLER){logLine("[private-squads] ERROR management refresh unavailable");}
+}
+static void __fastcall manageHook(SquadManagementScreen* p){manageOriginal(p);repairEmptyManagement(p);filterManage(p);}
+static void __fastcall refreshManageHook(SquadManagementScreen* p){refreshManageOriginal(p);filterManage(p);}
+static void __fastcall cellHook(PortraitMainCellView* p,const MyGUI::IBDrawItemInfo& info,PortraitData* data){
+    cellOriginal(p,info,data);
+    if(active()&&data&&p&&p->mMainWidget){int c=characterClass(data->getCharacter());p->mMainWidget->setVisible(c!=2);}
+}
+static void __fastcall squadCellHook(SquadManagementScreen::PortraitSquadCellView* p,const MyGUI::IBDrawItemInfo& info,PortraitData* data){
+    squadCellOriginal(p,info,data);
+    if(active()&&data&&p&&p->mMainWidget){int c=characterClass(data->getCharacter());p->mMainWidget->setVisible(c!=2);}
+}
+static ActivePlatoon* __fastcall createSquadHook(PlayerInterface* player){
+    ActivePlatoon* squad=createSquadOriginal(player);
+    if(active()&&addSquadDepth&&world&&player==world->player&&squad&&squad->me){
+        createdTabs.insert(squad->me->getHandle());
+        localTabs.insert(squad);
+    }
+    return squad;
+}
+static void __fastcall addSquadHook(SquadManagementScreen* screen,MyGUI::Widget* sender){
+    bool scoped=active()&&world&&world->player&&screen&&screen->faction==world->player->participant;
+    if(scoped)++addSquadDepth;
+    addSquadOriginal(screen,sender);
+    if(scoped)--addSquadDepth;
+    filterManage(screen);
+}
+static void __fastcall selectHook(PlayerInterface* p,RootObject* obj,bool select){
+    if(active()&&select&&characterClass(obj)==2)return;
+    selectOriginal(p,obj,select);
+}
+template<typename T> static bool hook(intptr_t address,void* replacement,T* original){
+    return address&&KenshiLib::AddHook(address,replacement,reinterpret_cast<void**>(original))==KenshiLib::SUCCESS;
+}
+} // privateSquads
+void privateSquadsTick(GameWorld* gw,bool on) {
+    using namespace privateSquads;
+    if(!gw||!on||gw!=world){createdTabs.clear();addSquadDepth=0;}
+    world=gw;enabled=on;mainThread=GetCurrentThreadId();ready=false;localTabs.clear();localCharacterCount=0;firstLocalCharacter=0;
+    if(!gw||!on||!classify)return;
+    Character* cs[160];unsigned int hs[160][5];
+    unsigned int n=snapshotRoster(gw,cs,hs,160);
+    for(unsigned int i=0;i<n;++i){
+        int c=characterClass(static_cast<RootObject*>(cs[i]));
+        if(c){ready=true;if(c==1){++localCharacterCount;if(!firstLocalCharacter)firstLocalCharacter=cs[i];if(g_getPlatoonFn){ActivePlatoon* p=g_getPlatoonFn(cs[i]);if(p)localTabs.insert(p);}}}
+    }
+    for(std::set<hand>::iterator it=createdTabs.begin();it!=createdTabs.end();){
+        hand identity=*it;
+        ActivePlatoon* p=identity.getActivePlatoon();
+        if(p){localTabs.insert(p);ready=true;++it;}else createdTabs.erase(it++);
+    }
+}
+bool installPrivateSquadUiHooks(InvOwnerClassFn owner) {
+    using namespace privateSquads;
+    classify=owner;
+    HMODULE mygui=GetModuleHandleA("MyGUIEngine_x64.dll");
+    removeUiItem=mygui?reinterpret_cast<RemoveUiItemFn>(GetProcAddress(mygui,"?removeItemAt@ItemBox@MyGUI@@QEAAX_K_N@Z")):0;
+    bool ok=removeUiItem!=0;
+    ok=hook(KenshiLib::GetRealAddress(&MainBarGUI::_NV_update),(void*)&barHook,&barOriginal)&&ok;
+    ok=hook(KenshiLib::GetRealAddress(&MainBarGUI::refreshPortraitTabs),(void*)&refreshBarHook,&refreshBarOriginal)&&ok;
+    ok=hook(KenshiLib::GetRealAddress(&SquadManagementScreen::update),(void*)&manageHook,&manageOriginal)&&ok;
+    ok=hook(KenshiLib::GetRealAddress(&SquadManagementScreen::refreshSquads),(void*)&refreshManageHook,&refreshManageOriginal)&&ok;
+    ok=hook(KenshiLib::GetRealAddress(&PortraitMainCellView::update),(void*)&cellHook,&cellOriginal)&&ok;
+    ok=hook(KenshiLib::GetRealAddress(&SquadManagementScreen::PortraitSquadCellView::update),(void*)&squadCellHook,&squadCellOriginal)&&ok;
+    ok=hook(KenshiLib::GetRealAddress(&PlayerInterface::objectSelected),(void*)&selectHook,&selectOriginal)&&ok;
+    ok=hook(KenshiLib::GetRealAddress(&SquadManagementScreen::onAddSquad),(void*)&addSquadHook,&addSquadOriginal)&&ok;
+    ok=hook(KenshiLib::GetRealAddress(&PlayerInterface::createSquad),(void*)&createSquadHook,&createSquadOriginal)&&ok;
+    logLine(ok?"[private-squads] UI hooks installed":"[private-squads] ERROR one or more UI hooks unavailable");
+    return ok;
+}
+} }
diff --git a/src/plugin/sync/PrivateSquadSession.h b/src/plugin/sync/PrivateSquadSession.h
new file mode 100644
index 0000000..1e20de0
--- /dev/null
+++ b/src/plugin/sync/PrivateSquadSession.h
@@ -0,0 +1,78 @@
+#pragma once
+#include "../game/Engine.h"
+#include <windows.h>
+#include <string>
+#include <vector>
+#include <map>
+#include <cstring>
+
+namespace coop {
+namespace savexfer { std::string saveFolderFor(const std::string& name); }
+// Main-thread save adapter. Ownership is recorded from the HOST's perspective
+// and restored onto each client's current native hand, ignoring local indices.
+// Pin restoration must precede publishOwned, whose normal census can otherwise
+// assign a newly created tab to the wrong initial sorted rank after a reload.
+class PrivateSquadSession {
+    struct Row { unsigned int container,serial,body,hostOwn; };
+    typedef std::vector<Row> Rows;
+    std::map<std::string,Rows> frozen_;
+    bool restored_,blocked_;
+    std::string restoredName_;
+    static bool safeName(const std::string& n){return !n.empty()&&n!="."&&n!=".."&&n.find_first_of("/\\:")==std::string::npos;}
+    static void put(std::vector<unsigned char>& out,unsigned int n){for(int i=0;i<4;++i)out.push_back((unsigned char)(n>>(8*i)));}
+    static unsigned int get(const std::vector<unsigned char>& in,unsigned int at){unsigned int n=0;for(int i=0;i<4;++i)n|=(unsigned int)in[at+i]<<(8*i);return n;}
+    static unsigned int checksum(const std::vector<unsigned char>& bytes,unsigned int n){unsigned int h=2166136261u;for(unsigned int i=0;i<n;++i){h^=bytes[i];h*=16777619u;}return h;}
+    static bool same(const Row& a,const Row& b){return a.container==b.container&&a.serial==b.serial&&a.body==b.body;}
+    static Row row(const EntityState& e,unsigned int own){Row r;r.container=e.hContainer;r.serial=e.hContainerSerial;r.body=e.hSerial;r.hostOwn=own;return r;}
+    static bool unique(const Rows& rows){for(unsigned int i=0;i<rows.size();++i){if(rows[i].hostOwn>1)return false;for(unsigned int j=0;j<i;++j)if(same(rows[i],rows[j]))return false;}return true;}
+    static std::vector<unsigned char> encode(const Rows& rows){
+        const unsigned char magic[8]={'K','C','S','Q','0','0','1',0};
+        std::vector<unsigned char> bytes(magic,magic+8);put(bytes,(unsigned int)rows.size());
+        for(unsigned int i=0;i<rows.size();++i){put(bytes,rows[i].container);put(bytes,rows[i].serial);put(bytes,rows[i].body);put(bytes,rows[i].hostOwn);}
+        put(bytes,checksum(bytes,(unsigned int)bytes.size()));return bytes;
+    }
+    static bool decode(const std::vector<unsigned char>& bytes,Rows& rows){
+        const unsigned char magic[8]={'K','C','S','Q','0','0','1',0};
+        if(bytes.size()<16||memcmp(&bytes[0],magic,8))return false;
+        unsigned int n=get(bytes,8);if(n>160||bytes.size()!=16+16*n)return false;
+        if(get(bytes,(unsigned int)bytes.size()-4)!=checksum(bytes,(unsigned int)bytes.size()-4))return false;
+        Rows parsed;for(unsigned int i=0;i<n;++i){unsigned int p=12+16*i;Row r;r.container=get(bytes,p);r.serial=get(bytes,p+4);r.body=get(bytes,p+8);r.hostOwn=get(bytes,p+12);parsed.push_back(r);}
+        if(!unique(parsed))return false;rows.swap(parsed);return true;
+    }
+public:
+    PrivateSquadSession():restored_(false),blocked_(false){}
+    void resetWorld(){restored_=blocked_=false;restoredName_.clear();frozen_.clear();}
+    bool blocked()const{return blocked_;}
+    bool restored()const{return restored_;}
+    template<class Repl> bool capture(GameWorld* gw,Repl& repl,const std::string& name){
+        frozen_.erase(name);if(!safeName(name)||!gw)return false;
+        EntityState members[160];unsigned int n=engine::captureSquad(gw,false,members,160);if(!n||n>160)return false;
+        Rows rows;for(unsigned int i=0;i<n;++i){unsigned int h[5]={members[i].hType,members[i].hContainer,members[i].hContainerSerial,members[i].hIndex,members[i].hSerial};int owner=repl.ownerClassForHand(h);if(owner!=1&&owner!=2)return false;rows.push_back(row(members[i],owner==1?1:0));}
+        if(!unique(rows))return false;frozen_[name]=rows;return true;
+    }
+    bool save(const std::string& name){
+        if(!safeName(name)||frozen_.find(name)==frozen_.end())return false;
+        std::vector<unsigned char> data=encode(frozen_[name]);std::string folder=savexfer::saveFolderFor(name);CreateDirectoryA(folder.c_str(),0);
+        std::string path=folder+"\\coop_squads.dat",tmp=path+".tmp";
+        HANDLE f=CreateFileA(tmp.c_str(),GENERIC_WRITE,0,0,CREATE_ALWAYS,FILE_ATTRIBUTE_NORMAL,0);if(f==INVALID_HANDLE_VALUE)return false;
+        DWORD written=0;bool ok=WriteFile(f,&data[0],(DWORD)data.size(),&written,0)!=0&&written==data.size()&&FlushFileBuffers(f)!=0;CloseHandle(f);
+        if(ok)ok=MoveFileExA(tmp.c_str(),path.c_str(),MOVEFILE_REPLACE_EXISTING|MOVEFILE_WRITE_THROUGH)!=0;if(!ok)DeleteFileA(tmp.c_str());return ok;
+    }
+    // True: absent legacy sidecar, or validated complete restoration. False:
+    // native roster not complete yet (retry), or invalid file (blocked=true).
+    // Validate ALL bytes and ALL identities before mutating even one pin.
+    template<class Repl> bool restore(GameWorld* gw,Repl& repl,const std::string& name,bool isHost){
+        if(blocked_)return false;if(restored_)return restoredName_==name;if(!safeName(name)||!gw)return false;
+        std::string path=savexfer::saveFolderFor(name)+"\\coop_squads.dat";
+        DWORD attr=GetFileAttributesA(path.c_str());if(attr==INVALID_FILE_ATTRIBUTES){DWORD err=GetLastError();if(err!=ERROR_FILE_NOT_FOUND&&err!=ERROR_PATH_NOT_FOUND)return false;restored_=true;restoredName_=name;return true;}
+        HANDLE f=CreateFileA(path.c_str(),GENERIC_READ,FILE_SHARE_READ,0,OPEN_EXISTING,FILE_ATTRIBUTE_NORMAL,0);if(f==INVALID_HANDLE_VALUE)return false;
+        DWORD high=0,size=GetFileSize(f,&high);std::vector<unsigned char> bytes;bool ok=!high&&size>=16&&size<=2576;DWORD got=0;
+        if(ok){bytes.resize(size);ok=ReadFile(f,&bytes[0],size,&got,0)!=0&&got==size;}CloseHandle(f);
+        Rows rows;if(!ok||!decode(bytes,rows)){blocked_=true;return false;}
+        EntityState current[160];unsigned int n=engine::captureSquad(gw,false,current,160);if(n>160||(!n&&!rows.empty()))return false;
+        std::vector<unsigned int> matches;for(unsigned int i=0;i<rows.size();++i){unsigned int match=160,count=0;for(unsigned int j=0;j<n;++j)if(same(rows[i],row(current[j],0))){match=j;++count;}if(count!=1)return false;matches.push_back(match);}
+        for(unsigned int i=0;i<rows.size();++i){const EntityState& e=current[matches[i]];unsigned int h[5]={e.hType,e.hContainer,e.hContainerSerial,e.hIndex,e.hSerial};repl.restorePrivateOwner(h,isHost?(rows[i].hostOwn!=0):(rows[i].hostOwn==0));}
+        restored_=true;restoredName_=name;return true;
+    }
+};
+}
diff --git a/src/plugin/sync/SeparateWallet.h b/src/plugin/sync/SeparateWallet.h
new file mode 100644
index 0000000..997b6be
--- /dev/null
+++ b/src/plugin/sync/SeparateWallet.h
@@ -0,0 +1,25 @@
+#pragma once
+
+// Two fixed player slots, independent of ephemeral transport peer IDs.
+// Engine wallet changes are deltas authored by the local player, not a second
+// copy of a shared total. Pure arithmetic so persistence/network tests can use
+// exactly the production ledger without loading the engine.
+namespace coop {
+class SeparateWallet {
+public:
+    SeparateWallet() : host(0), guest(0), ack(0), epoch(0) {}
+    int host, guest;
+    unsigned int ack, epoch;
+    static int bounded(__int64 value) {
+        return value < 0 ? 0 : value > 2147483647 ? 2147483647 : (int)value;
+    }
+    void seed(int total) {
+        if (total < 0) total = 0;
+        guest = total / 2; host = total - guest; ack = 0;
+    }
+    bool fold(unsigned int incomingEpoch, unsigned int sequence, int delta) {
+        if (!epoch || incomingEpoch != epoch || sequence != ack + 1) return false;
+        guest = bounded((__int64)guest + delta); ack = sequence; return true;
+    }
+};
+}
diff --git a/src/plugin/sync/SeparateWalletSession.h b/src/plugin/sync/SeparateWalletSession.h
new file mode 100644
index 0000000..8fc5add
--- /dev/null
+++ b/src/plugin/sync/SeparateWalletSession.h
@@ -0,0 +1,153 @@
+#pragma once
+#include "SeparateWallet.h"
+#include <cstdio>
+
+// Main-thread adapter. Persists both fixed slots INSIDE the coordinated save,
+// which SaveXfer includes in fingerprints, transfer, and atomic folder commit.
+namespace coop {
+class SeparateWalletSession {
+    struct Pending { unsigned int seq; int delta; Pending(unsigned int s, int d):seq(s),delta(d){} };
+    SeparateWallet ledger_;
+    std::deque<Pending> pending_;
+    bool ready_, blocked_;
+    int seen_;
+    unsigned int seq_;
+    unsigned long sentMs_;
+    bool dirty_;
+    __int64 earlyDelta_;
+    std::map<std::string,SeparateWallet> frozen_;
+    unsigned int checksum(int a,int b) const {
+        unsigned int h=2166136261u;
+        for(int k=0;k<8;++k){unsigned int v=(unsigned int)(k<4?a:b);h^=(v>>((k%4)*8))&255;h*=16777619u;}
+        return h;
+    }
+    bool safeName(const std::string& n) const {
+        return !n.empty() && n!="." && n!=".." && n.find_first_of("/\\:") == std::string::npos;
+    }
+    void send(NetLink& net,u32 id) {
+        MoneyPacket p; memset(&p,0,sizeof(p));p.type=PKT_MONEY;p.ownerId=id;
+        p.money=ledger_.guest;p.ackSeq=ledger_.ack;p.mode=1;p.epoch=ledger_.epoch;
+        net.queueMoney(p);sentMs_=GetTickCount();dirty_=false;
+    }
+    bool initializeHost(GameWorld* gw) {
+        int cur=-1;if(!engine::readPlayerWallet(gw,&cur)||cur<0)return false;
+        char name[64]={0};engine::saveInfo(name,sizeof(name),0,0);
+        std::string folder=savexfer::saveFolderFor(name);
+        std::string file=folder+"\\coop_wallets.dat";
+        DWORD attr=GetFileAttributesA(file.c_str());
+        if(attr!=INVALID_FILE_ATTRIBUTES){
+            FILE* f=fopen(file.c_str(),"rb");char data[160]={0};
+            size_t count=f?fread(data,1,sizeof(data)-1,f):0;if(f)fclose(f);
