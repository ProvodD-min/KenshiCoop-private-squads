+    reset();net.isHost_=false;ENetPeer peer;peer.state=ENET_PEER_STATE_CONNECTED;net.serverPeer_=&peer;transfer(44);net.drainForTest();
+    check(sent.size()==3 && sent[0].route==2 && sent[2].route==2,"connected join retains direct server peer routing");
