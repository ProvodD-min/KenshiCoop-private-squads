+    reset();coop::SaveReqPacket req={};req.type=coop::PKT_SAVE_REQ;net.queueSaveReq(req);transfer(55);coop::SaveAckPacket ack={};ack.type=coop::PKT_SAVE_ACK;net.queueSaveAck(ack);net.drainForTest();
