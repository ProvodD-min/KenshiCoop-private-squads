+from pathlib import Path
+import argparse,concurrent.futures,hashlib,heapq,json,os,random,select,socket,subprocess,threading,time
+HERE=Path(__file__).resolve().parent
+EXE=None
+class Relay:
+ def __init__(self,target,mtu,delay,jitter,loss,bps):
+  self.front=socket.socket(socket.AF_INET,socket.SOCK_DGRAM);self.front.bind(('127.0.0.1',0))
+  self.back=socket.socket(socket.AF_INET,socket.SOCK_DGRAM);self.back.bind(('127.0.0.1',0))
+  for s in (self.front,self.back):
+   if os.name=='nt':
+    try:s.ioctl(0x9800000C,False)
+    except (ValueError,OSError):pass
+  self.target=target;self.client=None;self.mtu=mtu;self.delay=delay;self.jitter=jitter;self.loss=loss;self.bps=bps
+  self.rng=random.Random(73421);self.next=[0.,0.];self.q=[];self.seq=0;self.stop=threading.Event()
+  self.stats={'seen':0,'forwarded':0,'mtu_dropped':0,'loss_dropped':0,'queue_dropped':0,'max_datagram':0,'max_forwarded_datagram':0,'max_queued_packets':0}
+  self.thread=threading.Thread(target=self.run,daemon=True);self.thread.start()
+ def run(self):
+  while not self.stop.is_set():
+   ready,_,_=select.select([self.front,self.back],[],[],.002)
+   for sock in ready:
+    try:data,addr=sock.recvfrom(65535)
+    except ConnectionResetError:continue  # ICMP while a fresh host binds/exits.
+    direction=0 if sock is self.front else 1
+    if direction==0:self.client=addr
+    if direction==1 and not self.client:continue
+    s=self.stats;s['seen']+=1;s['max_datagram']=max(s['max_datagram'],len(data))
+    if len(data)>self.mtu:s['mtu_dropped']+=1;continue
+    if self.rng.random()<self.loss:s['loss_dropped']+=1;continue
+    now=time.monotonic();due=now+(self.delay+self.rng.uniform(-self.jitter,self.jitter))/1000
+    if self.bps:
+     due=max(due,self.next[direction])
+     if due-now>1.:s['queue_dropped']+=1;continue
+     self.next[direction]=due+len(data)/self.bps
+    self.seq+=1;heapq.heappush(self.q,(due,self.seq,direction,data));s['max_queued_packets']=max(s['max_queued_packets'],len(self.q))
+   now=time.monotonic()
+   while self.q and self.q[0][0]<=now:
+    _,_,direction,data=heapq.heappop(self.q)
+    if direction==0:self.back.sendto(data,self.target)
+    elif self.client:self.front.sendto(data,self.client)
+    self.stats['forwarded']+=1;self.stats['max_forwarded_datagram']=max(self.stats['max_forwarded_datagram'],len(data))
+ def close(self):self.stop.set();self.thread.join();self.front.close();self.back.close()
+def free_port():
+ with socket.socket(socket.AF_INET,socket.SOCK_DGRAM) as s:s.bind(('127.0.0.1',0));return s.getsockname()[1]
+def tree(p):return {str(f.relative_to(p)):hashlib.sha256(f.read_bytes()).hexdigest() for f in p.rglob('*') if f.is_file()}
+def case(out,name,profile,mtu,delay=0,jitter=0,loss=0,bps=0,duration=30000):
+ directory=out/name;directory.mkdir();host=directory/'host';join=directory/'join';host.mkdir();join.mkdir()
+ save=host/'save/generated';save.mkdir(parents=True)
+ # Real SaveXfer sends generated files only; no game saves/assets are read.
+ rng=random.Random(6543);(save/'quick.save').write_bytes(rng.randbytes(3*1024*1024));(save/'coop_squads.dat').write_bytes(b'generated metadata');(save/'empty.dat').write_bytes(b'')
+ env=os.environ.copy();env.pop('KENSHICOOP_NETWORK_PROFILE',None)
+ if profile:env['KENSHICOOP_NETWORK_PROFILE']=profile
+ port=free_port();relay=Relay(('127.0.0.1',port),mtu,delay,jitter,loss,bps);exe=EXE;processes=[];streams=[]
+ try:
