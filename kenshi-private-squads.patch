+"""Compile actual Inbound.h and extracted pumpSaveReceive with fake save IO.
+
+A deterministic producer injection reproduces the final-chunk race without
+thread timing. Tests receiver ordering, not native disk IO, ENet, or game ABI.
+Original header+pump are the mutation control and must fail. Exit77 = no compiler.
+"""
+import argparse
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
