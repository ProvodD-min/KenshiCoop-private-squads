+namespace coop { namespace savexfer {
+static u32 activeId=0,checksum=0;
+static unsigned __int64 received=0,expected=0;
+static bool active=false;
+static std::vector<std::string> order;
+void onSaveBegin(const SaveBeginPacket& b){
+    activeId=b.xferId;active=true;received=0;expected=b.totalBytes;checksum=0;order.push_back("B");
+}
+void onSaveFile(const SaveFileHeader& f,const char*,const u8* data){
+    order.push_back("F");
+    if(active && f.xferId==activeId){received+=f.dataLen;for(unsigned i=0;i<f.dataLen;++i)checksum+=data[i];}
+    // Exact adverse interleaving: producer appends the final FILE and DONE after
+    // consumer took the old chunk batch, while processing an earlier chunk.
+    if(injectTail){injectTail=false;produceTail();}
+}
+int onSaveDone(const SaveDoneHeader& d,const u32* crcs,u16* files,unsigned __int64* bytes){
+    order.push_back("D");
+    bool ok=active && d.xferId==activeId && received==expected && crcs && crcs[0]==checksum;
