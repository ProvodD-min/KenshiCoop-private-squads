+    if(p[0]==coop::PKT_SAVE_DONE){coop::SaveDoneHeader h;std::memcpy(&h,p,sizeof(h));return h.xferId;}
+    return 0;
+}
+static void transfer(unsigned id){
+    coop::SaveBeginPacket b={};b.type=coop::PKT_SAVE_BEGIN;b.xferId=id;b.fileCount=1;b.totalBytes=2;net.queueSaveBegin(b);
+    coop::SaveFileHeader f={};f.type=coop::PKT_SAVE_FILE;f.xferId=id;f.pathLen=1;f.dataLen=2;
+    char path[]="a";unsigned char data[]={7,9};net.queueSaveFile(f,path,data,2);
