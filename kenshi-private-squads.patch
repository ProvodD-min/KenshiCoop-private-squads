+"""Run extracted production peer-event handlers against a fake engine/network.
+
+This tests reconnect lifecycle decisions, not the plugin ABI. A C++ compiler is
+required; exit 77 means unavailable. The old unconditional-leave behavior must
+fail the same cases as a mutation control. No game or network access is needed.
+"""
+import argparse
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[1]
+SOURCE = ROOT / "src/plugin/Plugin.cpp"
+
+PREFIX = r'''
+#include <cstdio>
+#include <deque>
+#include <set>
+#include <string>
+#include <vector>
+#ifndef _MSC_VER
+#define _snprintf snprintf
+#endif
+struct GameWorld {};
+namespace coop {
+    typedef unsigned int u32;
+    const u32 OWNER_ID_ALL = 0xffffffffu;
+    namespace engine {
+        static bool suppressed=false;
+        static int suppressWrites=0;
+        void setSaveSuppress(bool on){suppressed=on;++suppressWrites;}
+    }
+}
+struct Session {std::set<coop::u32> peerIds;} g_session;
+struct Cfg {bool isHost,latejoinSync,saveSync,carrySync,furnSync;} g_cfg;
+struct Net {unsigned localId(){return g_cfg.isHost?0:1;}void bumpSessionEpoch(){}} g_net;
+struct Inbound {
+    std::deque<coop::u32> connects,leaves;int flushes;
+    Inbound():flushes(0){}
+    void drainConnects(std::deque<coop::u32>& out){out.swap(connects);}
+    void drainLeaves(std::deque<coop::u32>& out){out.swap(leaves);}
+    void flushWorldState(){++flushes;}
+} g_inbound;
+struct Repl {
+    int clears,sweeps,resyncs,resets;
+    Repl():clears(0),sweeps(0),resyncs(0),resets(0){}
+    void onPeerConnected(Net&,unsigned){++resyncs;}
+    void sweepCarries(GameWorld*){++sweeps;}
+    void clearPeerReplicationState(GameWorld*){++clears;}
+    void resetSession(){++resets;}
+} g_repl;
+static bool g_peerPresent=false,g_gameStarted=false;
+static GameWorld* g_lastGw=0;
+static std::vector<std::string> logs;
+static void coopLog(const char* s){logs.push_back(s);}
+static void armConnectPush(){}
+'''
+
+SUFFIX = r'''
+static GameWorld world;
+static int failures=0;
+static void check(bool ok,const char* label){std::printf("%s %s\n",ok?"PASS":"FAIL",label);if(!ok)++failures;}
+static void reset(bool host=true){
+    g_session.peerIds.clear();g_peerPresent=false;g_lastGw=0;g_gameStarted=false;
+    g_inbound=Inbound();g_repl=Repl();logs.clear();
+    g_cfg.isHost=host;g_cfg.latejoinSync=true;g_cfg.saveSync=true;
+    g_cfg.carrySync=true;g_cfg.furnSync=true;
+    coop::engine::suppressed=false;coop::engine::suppressWrites=0;
+}
+static void connect(unsigned id){g_inbound.connects.push_back(id);processNetEvents(&world);}
+static void leave(unsigned id){g_inbound.leaves.push_back(id);processNetEvents(&world);}
+int main(){
+    reset();connect(2);connect(3);leave(2);
+    check(g_peerPresent,"replacement remains present after old socket disconnects");
+    check(g_repl.clears==0 && g_repl.sweeps==0 && g_inbound.flushes==0,"stale departure preserves replacement proxies carries and queues");
+    leave(3);
+    check(!g_peerPresent && g_repl.clears==1 && g_repl.sweeps==1 && g_inbound.flushes==1,"final departure tears down exactly once");
+    leave(3);leave(90);
+    check(g_repl.clears==1 && g_repl.sweeps==1 && g_inbound.flushes==1,"duplicate unknown departures cause no teardown");
+
+    reset();connect(4);g_inbound.connects.push_back(5);g_inbound.leaves.push_back(4);processNetEvents(&world);
+    check(g_peerPresent && g_repl.clears==0 && g_inbound.flushes==0,"same-drain replacement and old leave preserve session");
+
+    reset();connect(7);leave(0);
+    check(g_peerPresent && g_repl.clears==0,"unadmitted host socket disconnect cannot erase admitted peer");
+
+    reset(false);connect(0);leave(coop::OWNER_ID_ALL);
+    check(!g_peerPresent && !coop::engine::suppressed && coop::engine::suppressWrites==2 && g_repl.clears==1,"join wildcard departure releases sole host and native save suppression");
+    leave(coop::OWNER_ID_ALL);
+    check(g_repl.clears==1 && coop::engine::suppressWrites==2,"duplicate join wildcard is idempotent");
+
+    reset();connect(2);connect(3);g_inbound.leaves.push_back(2);g_inbound.leaves.push_back(3);processNetEvents(&world);
+    check(!g_peerPresent && g_repl.clears==1 && g_inbound.flushes==1,"all peer departures in one drain clear once");
+
+    reset();connect(2);connect(2);leave(2);
+    check(!g_peerPresent && g_repl.clears==1,"duplicate connect is one tracked socket");
+
+    reset();connect(2);sessionResetForUi();
+    check(!g_peerPresent && g_session.peerIds.empty(),"manual network reset clears peer identities");
+    connect(3);leave(3);
+    check(!g_peerPresent && g_repl.clears==1,"fresh UI session cannot inherit stale peers");
+
+    reset();connect(9);g_inbound.leaves.push_back(9);processNetEvents(0);
+    check(!g_peerPresent && g_repl.sweeps==0 && g_repl.clears==1,"title-screen final disconnect skips world carry access");
+    return failures?1:0;
+}
+'''
+
+def extract(source, name):
+    start = source.index("void " + name + "(")
+    end = source.index("\n}", start) + 2
+    return source[start:end]
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--emit", type=Path, help="emit isolated C++ without compiling")
+    args = parser.parse_args()
+    source = SOURCE.read_text(encoding="utf-8")
+    reset = extract(source, "sessionResetForUi")
+    events = extract(source, "processNetEvents")
+    if args.emit:
+        args.emit.write_text(PREFIX + reset + "\n" + events + SUFFIX, encoding="utf-8")
+        print("EMITTED", args.emit)
+        return 0
+    compiler = next((shutil.which(x) for x in ("cl", "clang++", "g++") if shutil.which(x)), None)
+    if not compiler:
+        print("SKIP: C++ compiler unavailable; native regression and mutation control did not run")
+        return 77
+    # Restore the exact original handler from the pinned source base for the A/B control.
+    old = subprocess.run(["git", "-C", str(ROOT), "show", "5a761e19a4184b42315e96ea7e92e3c1403d54db:src/plugin/Plugin.cpp"],
+                         capture_output=True, text=True, check=True).stdout
+    mutant = extract(old, "processNetEvents")
+    if mutant == events:
+        raise RuntimeError("Mutation is unchanged; patched handler was not found")
+    build = ROOT / "build"
+    build.mkdir(exist_ok=True)
+    with tempfile.TemporaryDirectory(prefix="kenshi-peer-", dir=build) as temp:
+        for label, handler, expected in (("fixed", events, True), ("old-handler", mutant, False)):
+            cpp = Path(temp) / (label + ".cpp")
+            exe = Path(temp) / (label + ".exe")
+            cpp.write_text(PREFIX + reset + "\n" + handler + SUFFIX, encoding="utf-8")
+            if Path(compiler).stem.lower() == "cl":
+                command = [compiler, "/nologo", "/EHsc", str(cpp), "/Fe" + str(exe)]
+            else:
+                command = [compiler, "-std=c++11", str(cpp), "-o", str(exe)]
+            subprocess.run(command, cwd=temp, check=True)
+            result = subprocess.run([str(exe)], capture_output=True, text=True)
+            print(label + ":\n" + result.stdout)
+            if (result.returncode == 0) != expected:
+                raise RuntimeError(label + " produced an unexpected result")
+    print("PASS: fixed production handler passes and old handler fails")
+    return 0
+
+if __name__ == "__main__":
+    raise SystemExit(main())
