+++ b/scripts/test_separate_wallet.cpp
@@ -0,0 +1,65 @@
+// Native VC100 regression for the actual production arithmetic ledger.
+// No game, network or disk mocks: this deliberately does not test the session adapter.
+#include "../src/plugin/sync/SeparateWallet.h"
+#include <cstdio>
+#include <climits>
+
+static int checks = 0, failures = 0;
+static void check(const char* name, bool ok) {
+    ++checks;
+    if (!ok) ++failures;
+    std::printf("%s %s\n", ok ? "PASS" : "FAIL", name);
+}
+
+int main() {
+    coop::SeparateWallet w;
+    check("default ledger has no authority epoch", w.epoch == 0 && w.ack == 0);
+    check("uninitialized authority cannot fold a guest delta", !w.fold(0, 1, 200));
+    w.seed(1000);
+    check("legacy total is divided equally", w.host == 500 && w.guest == 500);
+    w.seed(1001);
+    check("odd migration conserves every cat", w.host == 501 && w.guest == 500);
+    w.seed(INT_MAX);
+    check("maximum migration avoids signed overflow", (__int64)w.host + w.guest == INT_MAX);
+    w.seed(-50);
+    check("negative legacy input cannot create debt", w.host == 0 && w.guest == 0);
+    w.seed(1);
+    check("single cat belongs to exactly one slot", w.host == 1 && w.guest == 0);
+
+    w.seed(1000); w.epoch = 41;
+    check("first ordered guest spend is accepted", w.fold(41, 1, -120));
+    check("guest spend does not debit host", w.host == 500 && w.guest == 380 && w.ack == 1);
+    check("replayed guest spend is rejected", !w.fold(41, 1, -120));
+    check("replay preserves balances and sequence", w.host == 500 && w.guest == 380 && w.ack == 1);
+    check("missing preceding sequence is rejected", !w.fold(41, 3, -30));
+    check("stale world epoch is rejected", !w.fold(40, 2, -30));
+    check("future unnegotiated epoch is rejected", !w.fold(42, 2, -30));
+    check("zero epoch cannot authorize a guest", !w.fold(0, 2, 100));
+    check("rejected messages leave ledger unchanged", w.host == 500 && w.guest == 380 && w.ack == 1);
+    check("guest income only credits guest", w.fold(41, 2, 220) && w.guest == 600 && w.host == 500);
+    check("zero delta still acknowledges its ordered sequence", w.fold(41, 3, 0) && w.ack == 3 && w.guest == 600);
+    check("overdraft has an explicit zero floor", w.fold(41, 4, INT_MIN) && w.guest == 0 && w.host == 500);
+    check("maximum positive delta is bounded", w.fold(41, 5, INT_MAX) && w.guest == INT_MAX);
+    check("positive addition cannot overflow into debt", w.fold(41, 6, INT_MAX) && w.guest == INT_MAX);
+    check("minimum negative delta cannot underflow", w.fold(41, 7, INT_MIN) && w.guest == 0);
+    check("bounds clamp below zero", coop::SeparateWallet::bounded(-2147483649LL) == 0);
+    check("bounds clamp above engine wallet limit", coop::SeparateWallet::bounded(4294967294LL) == INT_MAX);
+
+    // Model independent host activity interleaved with 100 guest operations.
+    w.seed(1000); w.epoch = 99;
+    bool invariant = true;
+    for (unsigned int i = 1; i <= 100; ++i) {
+        w.host += 3;
+        int beforeHost = w.host;
+        int delta = (i % 2) ? -7 : 11;
+        int expected = coop::SeparateWallet::bounded((__int64)w.guest + delta);
+        invariant = w.fold(99, i, delta) && w.host == beforeHost &&
+                    w.guest == expected && w.ack == i && invariant;
+    }
+    check("interleaved independent economy preserves slot ownership", invariant && w.host == 800 && w.guest == 700);
+    coop::SeparateWallet frozen = w;
+    w.fold(99, 101, -10); w.host -= 20;
+    check("by-value save snapshot remains frozen during later spending", frozen.host == 800 && frozen.guest == 700 && frozen.ack == 100);
+    std::printf("separate-wallet: %d/%d checks passed\n", checks - failures, checks);
+    return failures ? 1 : 0;
+}
