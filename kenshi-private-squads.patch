+// Actual production session adapter with fake engine wallets/packet queues.
+// Uses real Win32 atomic sidecar IO in a fresh caller-supplied test directory.
+// No game processes or original saves are touched.
+#define WIN32_LEAN_AND_MEAN
+#define NOMINMAX
+#include <windows.h>
+#include <cstdio>
+#include <cstring>
+#include <string>
+#include <vector>
+#include <deque>
+#include <map>
+#include "../src/netproto/Wire.h"
+
+class GameWorld { public: int wallet; explicit GameWorld(int n):wallet(n){} };
+static std::string testRoot;
+namespace coop {
+void logLine(const char* text) { std::printf("LOG %s\n", text); }
+struct InboundMoney { MoneyPacket pkt; };
+struct InboundMoneyDelta { MoneyDeltaPacket pkt; };
+class Inbound {
+public:
+    std::deque<InboundMoney> money;
+    std::deque<InboundMoneyDelta> deltas;
+    void drainMoney(std::deque<InboundMoney>& out) { out.swap(money); }
+    void drainMoneyDeltas(std::deque<InboundMoneyDelta>& out) { out.swap(deltas); }
+    void push(const MoneyPacket& p) { InboundMoney v;v.pkt=p;money.push_back(v); }
+    void push(const MoneyDeltaPacket& p) { InboundMoneyDelta v;v.pkt=p;deltas.push_back(v); }
+};
+class NetLink {
+public:
+    std::vector<MoneyPacket> money;
+    std::vector<MoneyDeltaPacket> deltas;
+    void queueMoney(const MoneyPacket& p) { money.push_back(p); }
+    void queueMoneyDelta(const MoneyDeltaPacket& p) { deltas.push_back(p); }
+};
+namespace engine {
+bool readPlayerWallet(GameWorld* gw,int* out) { if(!gw||!out)return false;*out=gw->wallet;return true; }
+bool writePlayerWallet(GameWorld* gw,int value) { if(!gw||value<0)return false;gw->wallet=value;return true; }
+void saveInfo(char* out,unsigned int n,char*,unsigned int) { if(n){strncpy(out,"fixture",n-1);out[n-1]=0;} }
+}
+namespace savexfer {
+std::string saveFolderFor(const std::string& name) { return testRoot+"\\"+name; }
+}
+}
+#include "../src/plugin/sync/SeparateWalletSession.h"
+
+static int checks=0,failures=0;
+static void check(const char* name,bool ok) { ++checks;if(!ok)++failures;std::printf("%s %s\n",ok?"PASS":"FAIL",name); }
+static bool balances(const char* name,int wantHost,int wantGuest) {
+    std::string path=coop::savexfer::saveFolderFor(name)+"\\coop_wallets.dat";
+    FILE* f=fopen(path.c_str(),"rb");if(!f)return false;
+    int h=-1,g=-1;unsigned int sum=0;
+    int n=fscanf(f,"KCOOP_WALLETS_1 %d %d %u",&h,&g,&sum);fclose(f);
+    return n==3 && h==wantHost && g==wantGuest;
+}
+int main(int argc,char** argv) {
+    if(argc!=2){std::fprintf(stderr,"Pass a NEW empty directory inside local/native-regressions\n");return 2;}
+    testRoot=argv[1];
+    if(GetFileAttributesA(testRoot.c_str())!=INVALID_FILE_ATTRIBUTES){std::fprintf(stderr,"Refusing existing test directory\n");return 2;}
+    if(!CreateDirectoryA(testRoot.c_str(),0))return 2;
+    coop::SeparateWalletSession host,guest;
+    coop::Inbound hi,gi;coop::NetLink hn,gn;GameWorld hw(1000),gw(1000);
+    check("guest save gate starts closed",!guest.readyForSave());
+    host.tick(&hw,hi,hn,0,true);
+    check("host migrates shared balance once",hw.wallet==500 && hn.money.size()==1 && hn.money.back().money==500);
+    guest.tick(&gw,gi,gn,1,false);
+    check("uninitialized guest cannot spend host native wallet",gw.wallet==0 && !guest.readyForSave());
+    gi.push(hn.money.back());guest.tick(&gw,gi,gn,1,false);
+    check("authoritative first snapshot opens guest save gate",gw.wallet==500 && guest.readyForSave());
+
+    gw.wallet-=100;guest.tick(&gw,gi,gn,1,false);
+    check("local purchase immediately closes save gate",gw.wallet==400 && !guest.readyForSave());
+    check("purchase emits ordered debit",gn.deltas.size()==1 && gn.deltas[0].seq==1 && gn.deltas[0].delta==-100);
+    // Deliberately model the former CH_BULK request overtaking CH_RELIABLE money.
+    // The production readyForSave query prevents a caller from taking this path.
+    host.capture(&hw,"unsafe_before_ack");
+    check("bypassing save gate reproduces pre-debit frozen snapshot",host.save("unsafe_before_ack") && balances("unsafe_before_ack",500,500));
+    hi.push(gn.deltas[0]);host.tick(&hw,hi,hn,0,true);
+    check("host folds debit without spending host funds",hw.wallet==500 && hn.money.back().money==400 && hn.money.back().ackSeq==1);
+    check("guest gate waits for delivered ACK, not elapsed time",!guest.readyForSave());
+    gi.push(hn.money.back());guest.tick(&gw,gi,gn,1,false);
+    check("matching ACK opens guest save gate",guest.readyForSave() && gw.wallet==400);
+    host.capture(&hw,"after_ack");
+    check("ACK-fenced save persists both correct balances",host.save("after_ack") && balances("after_ack",500,400));
+    hw.wallet-=25;host.tick(&hw,hi,hn,0,true);
+    check("spend during folder quiescence cannot change frozen save",host.save("after_ack") && balances("after_ack",500,400));
+    host.capture(&hw,"later");
+    check("later save captures later host spending",host.save("later") && balances("later",475,400));
+
+    gw.wallet-=20;guest.tick(&gw,gi,gn,1,false);
+    check("second purchase remains pending before reconnect",!guest.readyForSave() && gn.deltas.back().seq==2);
+    gn.deltas.clear(); // Lost with the previous ENet connection.
+    guest.resetWorld(false);gw.wallet=475;
+    check("guest bootstrap reload keeps save gate closed",!guest.readyForSave());
+    gi.push(hn.money.back());guest.tick(&gw,gi,gn,3,false);
+    check("same-epoch reload preserves optimistic pending debit",gw.wallet==380 && !guest.readyForSave());
+    bool replay=!gn.deltas.empty() && gn.deltas.back().seq==2 && gn.deltas.back().delta==-20;
+    check("reconnect replays debit under replacement peer identity",replay && gn.deltas.back().ownerId==3);
+    if(replay){hi.push(gn.deltas.back());hi.push(gn.deltas.back());host.tick(&hw,hi,hn,0,true);}
+    check("duplicate reconnect replay debits exactly once",hn.money.back().money==380 && hn.money.back().ackSeq==2 && hw.wallet==475);
+    gi.push(hn.money.back());guest.tick(&gw,gi,gn,3,false);
+    check("replay ACK releases deferred guest save",guest.readyForSave() && gw.wallet==380);
+
+    // A different authority epoch denotes intentional rollback; old pending
+    // operations must not be replayed into the restored saved world.
+    gw.wallet-=10;guest.tick(&gw,gi,gn,3,false);guest.resetWorld(false);gw.wallet=500;
+    coop::MoneyPacket rollback=hn.money.back();++rollback.epoch;rollback.ackSeq=0;rollback.money=500;
+    gn.deltas.clear();gi.push(rollback);guest.tick(&gw,gi,gn,3,false);
+    check("new world epoch discards old-world pending purchase",gw.wallet==500 && guest.readyForSave() && gn.deltas.empty());
+    std::printf("separate-wallet-session: %d/%d checks passed\n",checks-failures,checks);
+    return failures?1:0;
+}
